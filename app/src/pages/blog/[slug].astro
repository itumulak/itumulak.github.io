---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { FiArrowLeft } from 'react-icons/fi';

import Layout from '../../layouts/Layout.astro';
import LayoutHeader from '../../components/LayoutHeader.astro';
import Section from '../../components/Section.astro';
import Headline from '../../components/Headline.astro';
import TagChip from '../../features/blog/TagChip.astro';

import { getPublishedPosts } from '../../features/blog/posts';
import { menuItems, socials } from '../../features/home/data';
import { withBase } from '../../lib/withBase';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${post.data.title} — Ian Tumulak`} description={post.data.excerpt}>
  <LayoutHeader menuItems={menuItems} socials={socials} />

  <main>
    <Section>
      <article class="mx-auto flex w-full max-w-[75ch] flex-col gap-y-6">
        <a
          href={withBase('/#blog')}
          class="text-text/70 hover:text-brand inline-flex w-fit items-center gap-x-2 text-sm font-semibold transition-colors"
        >
          <FiArrowLeft aria-hidden="true" /> Back to blog
        </a>

        <header class="flex flex-col gap-y-4">
          <h1><Headline text={post.data.title} /></h1>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <time
              datetime={post.data.date.toISOString()}
              class="text-text/60 text-sm font-extralight"
            >
              {formattedDate}
            </time>
            {
              post.data.tags.length > 0 && (
                <ul class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <li>
                      <TagChip name={tag} />
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </header>

        <div class="article-body flex flex-col gap-y-4 font-extralight">
          <Content />
        </div>
      </article>
    </Section>
  </main>
</Layout>

<style>
  .article-body :global(h2) {
    color: var(--color-text);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 0.5rem;
  }

  .article-body :global(h3) {
    color: var(--color-text);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 0.5rem;
  }

  .article-body :global(p) {
    color: color-mix(in srgb, var(--color-text) 80%, transparent);
    line-height: 1.75;
  }

  .article-body :global(a) {
    color: var(--color-brand);
    font-weight: 600;
    text-underline-offset: 2px;
  }

  .article-body :global(a:hover) {
    text-decoration: none;
  }

  .article-body :global(strong) {
    color: var(--color-text);
    font-weight: 700;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-inline-start: 1.5rem;
  }

  .article-body :global(ul) {
    list-style: disc;
  }

  .article-body :global(ol) {
    list-style: decimal;
  }

  .article-body :global(blockquote) {
    border-inline-start: 3px solid var(--color-brand);
    padding-inline-start: 1rem;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
    font-style: italic;
  }

  .article-body :global(code) {
    background: var(--color-light-dark);
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
    font-size: 0.9em;
  }

  .article-body :global(pre) {
    overflow-x: auto;
    border-radius: 0.5rem;
    padding: 1rem;
  }

  .article-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  .article-body :global(hr) {
    border-color: color-mix(in srgb, var(--color-text) 20%, transparent);
  }
</style>
